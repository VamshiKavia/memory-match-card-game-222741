{"is_source_file": true, "format": "JavaScript", "description": "This is a React custom hook module ('useGame') for managing the state and interactions of a memory flip card game. It handles game initialization, card flipping, resetting, timer management, and communicates with backend API endpoints such as createGame, flipCard, resetGame, getGame, and healthCheck. The code also manages local storage for high scores, visual UI state, and optimistically updates the game board for a responsive user experience.", "external_files": ["../lib/api"], "external_methods": ["createGame", "flipCard", "resetGame", "getGame", "healthCheck"], "published": ["useGame"], "classes": [], "methods": [{"name": "formatTime(seconds)", "description": "Utility function to format seconds into mm:ss string.", "scope": "", "scopeKind": ""}, {"name": "toBoard(cards)", "description": "Transforms backend card view array to UI board model with additional properties.", "scope": "", "scopeKind": ""}, {"name": "bestKey(size)", "description": "Generates localStorage key for storing best score based on game size.", "scope": "", "scopeKind": ""}, {"name": "loadBest(size)", "description": "Reads the best score from localStorage for a given game size.", "scope": "", "scopeKind": ""}, {"name": "saveBest(size, candidate)", "description": "Saves the given score as the best score if it is an improvement.", "scope": "", "scopeKind": ""}, {"name": "useGame()", "scope": "", "scopeKind": "", "description": "unavailable"}], "calls": ["react.useCallback", "react.useEffect", "react.useMemo", "react.useRef", "react.useState", "../lib/api.createGame", "../lib/api.flipCard", "../lib/api.resetGame", "../lib/api.getGame", "../lib/api.healthCheck"], "search-terms": ["useGame", "memory flip card", "backend API", "localStorage high score", "timer management", "react hooks", "card flipping logic", "session reconciliation", "optimistic UI"], "state": 2, "file_id": 15, "knowledge_revision": 89, "git_revision": "f823428694a23cc2